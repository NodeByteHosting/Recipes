{
    "meta": {
        "version": "PTDL_v2",
        "update_url": null
    },
    "exported_at": "2026-05-30T00:00:00+00:00",
    "name": "Rust",
    "author": "NodeByteHosting",
    "description": "Rust multiplayer server with steamcmd integration and auto-update support.",
    "features": [],
    "docker_images": {
        "ghcr.io/nodebytehosting/games:rust": "ghcr.io/nodebytehosting/games:rust"
    },
    "file_denylist": [],
    "startup": "./RustDedicated -batchmode +server.port {{SERVER_PORT}} +server.queryport {{QUERY_PORT}} +server.identity \"rust\" +rcon.port {{RCON_PORT}} +rcon.web true +rcon.password \\\"{{RCON_PASS}}\\\" +server.hostname \\\"{{RUST_SERVER_NAME}}\\\" +server.description \\\"{{RUST_SERVER_DESCRIPTION}}\\\" +server.url \\\"{{RUST_SERVER_URL}}\\\" +server.seed {{RUST_SERVER_SEED}} +server.worldsize {{RUST_SERVER_WORLDSIZE}} +server.maxplayers {{RUST_SERVER_MAXPLAYERS}} +server.tickrate {{RUST_SERVER_TICKRATE}} +server.saveinterval {{RUST_SERVER_SAVEINTERVAL}}",
    "config": {
        "files": "{}",
        "startup": "{\n    \"done\": \"Server startup complete\"\n}",
        "log": "{\n  \"custom\": false,\n  \"location\": \"latest.log\"\n}",
        "stop": "^C"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\nset -e\n\napt-get update -y\napt-get install -y --no-install-recommends ca-certificates curl lib32gcc-s1 lib32stdc++6 tar\n\nmkdir -p /mnt/server/steamcmd\ncd /mnt/server/steamcmd\ncurl -sSL https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz | tar -xzf -\n\nexport HOME=/mnt/server\n./steamcmd.sh +force_install_dir /mnt/server +login anonymous +app_update 258550 validate +quit\n\nmkdir -p /mnt/server/.steam/sdk32 /mnt/server/.steam/sdk64\ncp -f linux32/steamclient.so /mnt/server/.steam/sdk32/steamclient.so\ncp -f linux64/steamclient.so /mnt/server/.steam/sdk64/steamclient.so\n\necho \"Rust server installed.\"\n",
            "container": "ghcr.io/nodebytehosting/installers:debian",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "Auto Update",
            "description": "Automatically download latest Rust server binaries on startup",
            "env_variable": "AUTO_UPDATE",
            "default_value": "1",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|in:0,1",
            "field_type": "text"
        },
        {
            "name": "Server Name",
            "description": "Server name displayed in server browser",
            "env_variable": "RUST_SERVER_NAME",
            "default_value": "Rust Server",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:64",
            "field_type": "text"
        },
        {
            "name": "Server Description",
            "description": "Server description shown in browser",
            "env_variable": "RUST_SERVER_DESCRIPTION",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string|max:256",
            "field_type": "text"
        },
        {
            "name": "Server URL",
            "description": "Server website URL",
            "env_variable": "RUST_SERVER_URL",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string|url",
            "field_type": "text"
        },
        {
            "name": "World Seed",
            "description": "World seed for deterministic generation (empty for random)",
            "env_variable": "RUST_SERVER_SEED",
            "default_value": "12345",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|numeric",
            "field_type": "text"
        },
        {
            "name": "World Size",
            "description": "World size in meters (typical: 3500)",
            "env_variable": "RUST_SERVER_WORLDSIZE",
            "default_value": "3500",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|numeric|between:1000,8000",
            "field_type": "text"
        },
        {
            "name": "Max Players",
            "description": "Maximum player slots",
            "env_variable": "RUST_SERVER_MAXPLAYERS",
            "default_value": "100",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|numeric|between:1,500",
            "field_type": "text"
        },
        {
            "name": "Tick Rate",
            "description": "Server tick rate (higher = more responsive, more CPU)",
            "env_variable": "RUST_SERVER_TICKRATE",
            "default_value": "30",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|numeric|between:15,60",
            "field_type": "text"
        },
        {
            "name": "Save Interval",
            "description": "Auto-save interval in seconds",
            "env_variable": "RUST_SERVER_SAVEINTERVAL",
            "default_value": "300",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|numeric|between:60,3600",
            "field_type": "text"
        },
        {
            "name": "Query Port",
            "description": "Port for server list queries.",
            "env_variable": "QUERY_PORT",
            "default_value": "28017",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|numeric|between:1024,65535",
            "field_type": "text"
        },
        {
            "name": "RCON Port",
            "description": "Port for RCON.",
            "env_variable": "RCON_PORT",
            "default_value": "28016",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|numeric|between:1024,65535",
            "field_type": "text"
        },
        {
            "name": "RCON Password",
            "description": "Password for RCON.",
            "env_variable": "RCON_PASS",
            "default_value": "changeme",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:64",
            "field_type": "text"
        }
    ]
}
